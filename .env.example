# Powder-AI Environment Configuration

# Application Mode: development or production
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=debug
LOG_DIR=~/.powder-ai/logs

# Python Engine Configuration
PYTHON_EXECUTABLE=python3
PYTHON_ENGINE_PATH=src/python/engine.py
PYTHON_COMMAND_TIMEOUT=30000

# Database Configuration
DATABASE_PATH=~/.powder-ai/data.db
DATABASE_MIGRATIONS_PATH=src/db/migrations

# UI Configuration
REACT_APP_API_ENDPOINT=http://localhost:3000
REACT_APP_VERSION=0.1.0

# Feature Flags
FEATURE_GPU_ACCELERATION=true
FEATURE_MODEL_CACHING=true
